{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "alannasantoso/dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.mjs"
    },
    {
      "src": "/dress-up-secret/?",
      "dest": "/dress-up-secret/index.html"
    },
    {
      "src": "/dress-up-secret/(.*)",
      "dest": "/dress-up-secret/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
